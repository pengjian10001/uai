<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <!-- 保持原有头部内容不变 -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI对话框</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/marked@4.2.12/marked.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/dompurify@2.3.11/dist/purify.min.js"></script>
    <!-- 原有样式配置保持不变 -->
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#165DFF',
                        neutral: {
                            100: '#F5F7FA',
                            200: '#E4E7ED',
                            300: '#C0C6CF',
                            400: '#909399',
                            500: '#606266',
                            600: '#303133',
                        }
                    },
                    fontFamily: {
                        inter: ['Inter', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        /* 保持原有样式不变 */
        @layer utilities {
            .content-auto {
                content-visibility: auto;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            .typing-animation::after {
                content: '';
                animation: typing 1.5s infinite;
            }
            @keyframes typing {
                0%, 100% { content: ''; }
                25% { content: '.'; }
                50% { content: '..'; }
                75% { content: '...'; }
            }
            .message-enter {
                opacity: 0;
                transform: translateY(10px);
            }
            .message-enter-active {
                opacity: 1;
                transform: translateY(0);
                transition: opacity 300ms, transform 300ms;
            }
            /* Markdown样式增强 */
            .markdown-content h1, .markdown-content h2, .markdown-content h3 {
                font-weight: bold;
                margin-top: 1rem;
                margin-bottom: 0.5rem;
            }
            .markdown-content h1 { font-size: 1.5rem; }
            .markdown-content h2 { font-size: 1.25rem; }
            .markdown-content h3 { font-size: 1.1rem; }
            .markdown-content p { margin-bottom: 0.75rem; }
            .markdown-content ul, .markdown-content ol { margin-left: 1.5rem; margin-bottom: 0.75rem; }
            .markdown-content ul { list-style-type: disc; }
            .markdown-content ol { list-style-type: decimal; }
            .markdown-content code {
                background-color: rgba(0,0,0,0.05);
                padding: 0.1rem 0.3rem;
                border-radius: 0.25rem;
                font-family: monospace;
            }
            .markdown-content pre {
                background-color: rgba(0,0,0,0.05);
                padding: 0.75rem;
                border-radius: 0.25rem;
                margin-bottom: 0.75rem;
                overflow-x: auto;
            }
            .markdown-content blockquote {
                border-left: 3px solid #ccc;
                padding-left: 0.75rem;
                margin-left: 0.5rem;
                color: #666;
                font-style: italic;
            }
            .markdown-content a {
                color: #165DFF;
                text-decoration: underline;
            }
            .markdown-content img {
                max-width: 100%;
                height: auto;
                margin: 0.75rem 0;
                border-radius: 0.25rem;
            }
            /* 确保用户消息文本为白色 */
            .user-message .markdown-content {
                color: white !important;
            }
            .user-message .markdown-content a {
                color: white !important;
                text-decoration: underline;
            }
            .user-message .markdown-content code {
                background-color: rgba(255,255,255,0.2) !important;
                color: white !important;
            }
            .user-message .markdown-content pre {
                background-color: rgba(255,255,255,0.1) !important;
                color: white !important;
            }
        }
    </style>
</head>
<body class="font-inter bg-neutral-100 min-h-screen">
    <!-- 保持原有HTML结构不变 -->
    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <!-- 头部 -->
            <div class="bg-primary text-white px-6 py-4 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <i class="fa fa-robot text-white"></i>
                    </div>
                    <h1 class="font-bold text-lg">AI助手</h1>
                </div>
                <div id="status-indicator" class="text-sm flex items-center">
                    <span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span>
                    <span>已连接</span>
                </div>
            </div>
            
            <!-- 消息区域 -->
            <div id="chat-container" class="h-[60vh] overflow-y-auto p-4 scrollbar-hide space-y-4">
                <!-- 系统消息 -->
                <div class="flex items-start mb-4 animate-[message-enter_0.3s_ease-out]">
                    <div class="flex-shrink-0 mr-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <i class="fa fa-info-circle text-primary"></i>
                        </div>
                    </div>
                    <div class="bg-neutral-100 rounded-lg p-3 max-w-[85%]">
                        <p class="text-neutral-700">欢迎使用AI助手！我支持Markdown语法，你可以输入**加粗文本**、[链接](https://example.com)或`代码`等格式。请问有什么可以帮助你的？</p>
                    </div>
                </div>
            </div>
            
            <!-- 输入区域 -->
            <div class="border-t border-neutral-200 p-4">
                <div class="relative">
                    <textarea id="user-input" rows="1" class="w-full px-4 py-3 pr-12 rounded-lg border border-neutral-300 bg-white text-neutral-700 focus:outline-none focus:ring-2 focus:ring-primary transition-all resize-none" placeholder="输入问题或指令..."></textarea>
                    <button id="send-button" class="absolute right-3 bottom-3 p-2 rounded-full bg-primary text-white hover:bg-primary/90 transition-colors">
                        <i class="fa fa-paper-plane"></i>
                    </button>
                </div>
                <div class="flex justify-between items-center mt-2 text-xs text-neutral-500">
                    <div class="flex items-center">
                        <span>支持Markdown语法</span>
                        <span class="mx-2">|</span>
                        <span class="font-mono">会话ID: <span id="session-id-value">生成中...</span></span>
                    </div>
                    <div>按Enter发送，Shift+Enter换行</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 配置远程服务地址 - 注意：流式输出通常需要WebSocket或SSE端点
        const API_URL = '/commonsse/api/test'; // 替换为实际流式API地址
        
        // DOM元素
        const userInput = document.getElementById('user-input');
        const sendButton = document.getElementById('send-button');
        const chatContainer = document.getElementById('chat-container');
        const statusIndicator = document.getElementById('status-indicator');
        const sessionIdValue = document.getElementById('session-id-value');
        
        // 初始化Marked配置
        marked.setOptions({
            breaks: true, // 支持单行换行
            gfm: true,    // 支持GitHub风格Markdown
        });
        
        // 自动调整输入框高度（保持不变）
        userInput.addEventListener('input', function() {
            const cursorPos = this.selectionStart;
            this.style.height = 'auto';
            this.style.overflowY = 'hidden';
            
            let newHeight = this.scrollHeight;
            if (newHeight > 150) {
                newHeight = 150;
                this.style.overflowY = 'auto';
            }
            
            this.style.height = newHeight + 'px';
            this.selectionStart = cursorPos;
            this.selectionEnd = cursorPos;
        });
        
        // 会话ID相关函数（保持不变）
        function getSessionIdFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('sessionId');
        }
        
        function getClientFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('clientName');
        }
        
        function generateSessionId() {
            const timestamp = Date.now().toString(36);
            const random = Math.random().toString(36).substring(2, 10);
            return timestamp + random;
        }
        
        function getUcIdFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('ucid');
        }
        
        // 会话ID初始化（保持不变）
        const sessionId = getSessionIdFromUrl() || generateSessionId();
        const clientName = getClientFromUrl() || 'test-client';
        const ucid = getUcIdFromUrl() || '0';
        
        function initSessionIdDisplay() {
            if (sessionIdValue) sessionIdValue.textContent = sessionId;
        }        
        
        // 修改发送消息函数以支持流式输出
        async function sendMessage() {
            const message = userInput.value.trim();
            if (!message) return;
            
            // 添加用户消息
            addMessage('user', message, false, true);
            
            // 清空输入框
            userInput.value = '';
            userInput.style.height = 'auto';
            
            // 添加AI回复容器（初始为空）
            const aiMessageElement = addMessage('ai', '', true, true);
            const contentContainer = aiMessageElement.querySelector('.markdown-content');
            
            try {
                // 显示连接状态
                updateStatus('connecting');
                
                // 使用Fetch API的流式响应（需要服务器支持）
                const response = await fetch(API_URL, {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/x-www-form-urlencoded',
                    },
                    body: new URLSearchParams({
                        sessionId: sessionId,
                        clientName: clientName,
                        ucid: ucid,
                        message: message
                    })
                });
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // 获取响应流的阅读器
                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let fullResponse = '';
                
                // 读取流数据
                while (true) {
                    const { done, value } = await reader.read();
                    if (done) break;
                    
                    // 解码新接收的部分
                    const chunk = decoder.decode(value, { stream: true });
                    fullResponse += chunk;
                    
                    // 更新UI显示（渲染Markdown）
                    const markdownHtml = marked.parse(fullResponse);
                    const cleanHtml = DOMPurify.sanitize(markdownHtml);
                    contentContainer.innerHTML = cleanHtml;
                    
                    // 滚动到底部
                    chatContainer.scrollTop = chatContainer.scrollHeight;
                }
                
                // 完成接收
                updateStatus('success');
            } catch (error) {
                console.error('Error fetching AI response:', error);
                contentContainer.innerHTML = '抱歉，获取响应时发生错误。请稍后再试。';
                updateStatus('error');
            }
        }
        
        // 修改添加消息函数以支持流式更新
        function addMessage(sender, content, isLoading = false, isMarkdown = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `flex items-start ${sender === 'user' ? 'justify-end' : ''} mb-4 animate-[message-enter_0.3s_ease-out]`;
            
            if (sender === 'user') {
                messageDiv.classList.add('user-message');
            }
            
            let avatarHtml, messageContentHtml, avatarClass, bgClass, textClass, icon;
            
            if (sender === 'user') {
                avatarClass = 'bg-neutral-300 text-neutral-600';
                bgClass = 'bg-primary';
                textClass = 'text-white';
                icon = 'fa-user';
            } else if (sender === 'ai') {
                avatarClass = 'bg-primary text-white';
                bgClass = 'bg-neutral-100';
                textClass = 'text-neutral-700';
                icon = 'fa-robot';
            } else { // system
                avatarClass = 'bg-yellow-100 text-yellow-800';
                bgClass = 'bg-yellow-50';
                textClass = 'text-yellow-700';
                icon = 'fa-exclamation-triangle';
            }
            
            avatarHtml = `
                <div class="flex-shrink-0 ${sender === 'user' ? 'ml-3' : 'mr-3'}">
                    <div class="w-8 h-8 rounded-full ${avatarClass} flex items-center justify-center">
                        <i class="fa ${icon}"></i>
                    </div>
                </div>
            `;
            
            if (isLoading) {
                // 初始加载状态 - 为流式输出准备容器
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <div class="markdown-content">${content}</div>
                    </div>
                `;
            } else if (isMarkdown) {
                // 处理Markdown内容
                const markdownHtml = marked.parse(content);
                const cleanHtml = DOMPurify.sanitize(markdownHtml);
                
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <div class="markdown-content">${cleanHtml}</div>
                    </div>
                `;
            } else {
                // 普通文本内容
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <p class="${textClass}">${formatMessage(content)}</p>
                    </div>
                `;
            }
            
            messageDiv.innerHTML = sender === 'user' ? messageContentHtml + avatarHtml : avatarHtml + messageContentHtml;
            chatContainer.appendChild(messageDiv);
            
            // 滚动到底部
            chatContainer.scrollTop = chatContainer.scrollHeight;
            
            // 如果是AI消息且处于加载状态，返回元素引用以便后续更新
            if (sender === 'ai' && isLoading) {
                return messageDiv;
            }
        }
        
        // 其他函数保持不变
        function updateStatus(status) {
            const statusText = statusIndicator.querySelector('span:last-child');
            const statusDot = statusIndicator.querySelector('span:first-child');
            
            if (status === 'connecting') {
                statusText.textContent = '连接中...';
                statusDot.className = 'w-2 h-2 rounded-full bg-yellow-500 mr-2';
            } else if (status === 'success') {
                statusText.textContent = '已连接';
                statusDot.className = 'w-2 h-2 rounded-full bg-green-500 mr-2';
            } else if (status === 'error') {
                statusText.textContent = '连接错误';
                statusDot.className = 'w-2 h-2 rounded-full bg-red-500 mr-2';
            }
        }
        
        function formatMessage(content) {
            return content.replace(/\n/g, '<br>');
        }
        
        // 事件绑定（保持不变）
        sendButton.addEventListener('click', sendMessage);
        
        let isComposing = false;
        
        userInput.addEventListener('compositionstart', () => {
          isComposing = true;
        });
        
        userInput.addEventListener('compositionend', () => {
          isComposing = false;
        });
        
        userInput.addEventListener('keydown', (e) => {
          if (e.key === 'Enter' && !e.shiftKey && !isComposing) {
            e.preventDefault();
            sendMessage();
          }
        });
        
        // 初始化
        userInput.focus();
        
        function testConnection() {
            updateStatus('connecting');
            
            fetch(API_URL, { method: 'HEAD' })
                .then(response => {
                    if (response.ok) {
                        updateStatus('success');
                    } else {
                        updateStatus('error');
                    }
                })
                .catch(error => {
                    console.error('Connection test failed:', error);
                    updateStatus('error');
                });
        }
        
        document.addEventListener('DOMContentLoaded', () => {
            initSessionIdDisplay();
            testConnection();
        });
    </script>
</body>
</html>