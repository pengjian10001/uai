<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AI对话框</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdn.jsdelivr.net/npm/font-awesome@4.7.0/css/font-awesome.min.css" rel="stylesheet">
    <!-- Markdown解析库 -->
    <script src="https://cdn.jsdelivr.net/npm/marked@4.2.12/marked.min.js"></script>
    <!-- HTML净化库 -->
    <script src="https://cdn.jsdelivr.net/npm/dompurify@2.3.11/dist/purify.min.js"></script>
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        primary: '#165DFF',
                        neutral: {
                            100: '#F5F7FA',
                            200: '#E4E7ED',
                            300: '#C0C6CF',
                            400: '#909399',
                            500: '#606266',
                            600: '#303133',
                        }
                    },
                    fontFamily: {
                        inter: ['Inter', 'system-ui', 'sans-serif'],
                    },
                }
            }
        }
    </script>
    <style type="text/tailwindcss">
        @layer utilities {
            .content-auto {
                content-visibility: auto;
            }
            .scrollbar-hide {
                -ms-overflow-style: none;
                scrollbar-width: none;
            }
            .scrollbar-hide::-webkit-scrollbar {
                display: none;
            }
            .typing-animation::after {
                content: '';
                animation: typing 1.5s infinite;
            }
            @keyframes typing {
                0%, 100% { content: ''; }
                25% { content: '.'; }
                50% { content: '..'; }
                75% { content: '...'; }
            }
            .message-enter {
                opacity: 0;
                transform: translateY(10px);
            }
            .message-enter-active {
                opacity: 1;
                transform: translateY(0);
                transition: opacity 300ms, transform 300ms;
            }
            /* Markdown样式增强 */
            .markdown-content h1, .markdown-content h2, .markdown-content h3 {
                font-weight: bold;
                margin-top: 1rem;
                margin-bottom: 0.5rem;
            }
            .markdown-content h1 { font-size: 1.5rem; }
            .markdown-content h2 { font-size: 1.25rem; }
            .markdown-content h3 { font-size: 1.1rem; }
            .markdown-content p { margin-bottom: 0.75rem; }
            .markdown-content ul, .markdown-content ol { margin-left: 1.5rem; margin-bottom: 0.75rem; }
            .markdown-content ul { list-style-type: disc; }
            .markdown-content ol { list-style-type: decimal; }
            .markdown-content code {
                background-color: rgba(0,0,0,0.05);
                padding: 0.1rem 0.3rem;
                border-radius: 0.25rem;
                font-family: monospace;
            }
            .markdown-content pre {
                background-color: rgba(0,0,0,0.05);
                padding: 0.75rem;
                border-radius: 0.25rem;
                margin-bottom: 0.75rem;
                overflow-x: auto;
            }
            .markdown-content blockquote {
                border-left: 3px solid #ccc;
                padding-left: 0.75rem;
                margin-left: 0.5rem;
                color: #666;
                font-style: italic;
            }
            .markdown-content a {
                color: #165DFF;
                text-decoration: underline;
            }
            .markdown-content img {
                max-width: 100%;
                height: auto;
                margin: 0.75rem 0;
                border-radius: 0.25rem;
            }
            /* 确保用户消息文本为白色 */
            .user-message .markdown-content {
                color: white !important;
            }
            .user-message .markdown-content a {
                color: white !important;
                text-decoration: underline;
            }
            .user-message .markdown-content code {
                background-color: rgba(255,255,255,0.2) !important;
                color: white !important;
            }
            .user-message .markdown-content pre {
                background-color: rgba(255,255,255,0.1) !important;
                color: white !important;
            }
        }
    </style>
</head>
<body class="font-inter bg-neutral-100 min-h-screen">
    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="bg-white rounded-xl shadow-lg overflow-hidden">
            <!-- 头部 -->
            <div class="bg-primary text-white px-6 py-4 flex items-center justify-between">
                <div class="flex items-center space-x-3">
                    <div class="w-8 h-8 rounded-full bg-white/20 flex items-center justify-center">
                        <i class="fa fa-robot text-white"></i>
                    </div>
                    <h1 class="font-bold text-lg">AI助手</h1>
                </div>
                <div id="status-indicator" class="text-sm flex items-center">
                    <span class="w-2 h-2 rounded-full bg-green-500 mr-2"></span>
                    <span>已连接</span>
                </div>
            </div>
            
            <!-- 消息区域 -->
            <div id="chat-container" class="h-[60vh] overflow-y-auto p-4 scrollbar-hide space-y-4">
                <!-- 系统消息 -->
                <div class="flex items-start mb-4 animate-[message-enter_0.3s_ease-out]">
                    <div class="flex-shrink-0 mr-3">
                        <div class="w-8 h-8 rounded-full bg-primary/10 flex items-center justify-center">
                            <i class="fa fa-info-circle text-primary"></i>
                        </div>
                    </div>
                    <div class="bg-neutral-100 rounded-lg p-3 max-w-[85%]">
                        <p class="text-neutral-700">欢迎使用AI助手！我支持Markdown语法，你可以输入**加粗文本**、[链接](https://example.com)或`代码`等格式。请问有什么可以帮助你的？</p>
                    </div>
                </div>
            </div>
            
            <!-- 输入区域 -->
            <div class="border-t border-neutral-200 p-4">
                <!-- 文件上传预览区域 -->
                <div id="file-preview-container" class="flex flex-wrap gap-2 mb-2"></div>
                <span id="file-size-warning" class="text-red-500 text-xs ml-2 hidden">文件大小不能超过10MB</span>
                
                <div class="relative">
                    <!-- 左侧功能按钮 -->
                    <div class="absolute left-3 top-1/2 transform -translate-y-1/2 flex items-center space-x-1">
                        <!-- 上传文件按钮 - 仅显示回纹针图标 -->
                        <label for="file-upload" class="w-9 h-9 rounded-full flex items-center justify-center text-neutral-500 hover:bg-neutral-100 transition-colors cursor-pointer relative group">
                            <i class="fa fa-paperclip"></i>
                            <span class="absolute -bottom-8 left-1/2 transform -translate-x-1/2 bg-gray-800 text-white text-xs py-1 px-2 rounded opacity-0 group-hover:opacity-100 transition-opacity whitespace-nowrap">
                                上传文件
                            </span>
                            <input id="file-upload" type="file" class="hidden" multiple accept="image/*,.pdf,.doc,.docx,.xls,.xlsx,.ppt,.pptx,.txt,.zip,.rar">
                        </label>
                    </div>
                    
                    <textarea id="user-input" rows="1" class="w-full px-12 py-3 pr-12 rounded-lg border border-neutral-300 bg-white text-neutral-700 focus:outline-none focus:ring-2 focus:ring-primary transition-all resize-none" placeholder="输入问题或指令..."></textarea>
                    
                    <button id="send-button" class="absolute right-3 bottom-3 p-2 rounded-full bg-primary text-white hover:bg-primary/90 transition-colors">
                        <i class="fa fa-paper-plane"></i>
                    </button>
                </div>
                
                <div class="flex justify-between items-center mt-2 text-xs text-neutral-500">
                    <div class="flex items-center">
                        <span>支持Markdown语法</span>
                        <span class="mx-2">|</span>
                        <span class="font-mono">会话ID: <span id="session-id-value">生成中...</span></span>
                    </div>
                    <div>按Enter发送，Shift+Enter换行</div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // 配置远程服务地址
        const API_URL = '/stream/mcp/chat/aiquery'; // 替换为实际API地址
        
        // DOM元素
        const userInput = document.getElementById('user-input');
        const sendButton = document.getElementById('send-button');
        const chatContainer = document.getElementById('chat-container');
        const statusIndicator = document.getElementById('status-indicator');
        const sessionIdValue = document.getElementById('session-id-value');
        const sessionIdDisplay = document.getElementById('session-id-display');
        
        // 初始化Marked配置
        marked.setOptions({
            breaks: true, // 支持单行换行
            gfm: true,    // 支持GitHub风格Markdown
        });
        
        // 自动调整输入框高度
        userInput.addEventListener('input', function() {
        	// 保存当前光标位置
            const cursorPos = this.selectionStart;
            
            // 临时移除滚动和高度限制以计算正确高度
            this.style.height = 'auto';
            this.style.overflowY = 'hidden';
            
            // 计算所需高度
            let newHeight = this.scrollHeight;
            // 限制最大高度
            if (newHeight > 150) {
                newHeight = 150;
                this.style.overflowY = 'auto';
            }
            
            // 设置新高度
            this.style.height = newHeight + 'px';
            
            // 恢复光标位置
            this.selectionStart = cursorPos;
            this.selectionEnd = cursorPos;
        });
        
        // 从URL参数获取会话ID
        function getSessionIdFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('sessionId');
        }
        
        // 从URL参数获取client
        function getClientFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('clientName');
        }
        
        // 生成唯一会话ID（模拟long型数字）
        function generateSessionId() {
            // 使用时间戳和随机数组合生成唯一ID
            const timestamp = Date.now().toString(36);
            const random = Math.random().toString(36).substring(2, 10);
            return timestamp + random;
        }
        
        // 从URL参数获取用户ID
        function getUcIdFromUrl() {
            const urlParams = new URLSearchParams(window.location.search);
            return urlParams.get('ucid');
        }
        
        // 会话ID，优先从URL获取，否则生成新的
        const sessionId = getSessionIdFromUrl() || generateSessionId();
        const clientName = getClientFromUrl() || 'test-client';
        const ucid = getUcIdFromUrl() || '0';
        console.log('Generated Session ID:', sessionId);
        console.log('clientName:', clientName);
        console.log('ucid:', ucid);
        
        // 初始化会话ID显示
        function initSessionIdDisplay() {
            if (sessionIdValue) sessionIdValue.textContent = sessionId;
            if (sessionIdDisplay) sessionIdDisplay.textContent = sessionId;
        }
        
        // 文件上传相关元素
        const fileUpload = document.getElementById('file-upload');
        const filePreviewContainer = document.getElementById('file-preview-container');
        const fileSizeWarning = document.getElementById('file-size-warning');
        const maxFileSize = 30 * 1024 * 1024; // 30MB
        let selectedFiles = []; // 存储选中的文件
        
        // 处理文件选择
        fileUpload.addEventListener('change', handleFileSelection);
        
        function handleFileSelection(e) {
            const files = e.target.files;
            if (!files.length) return;
        
            // 重置警告
            fileSizeWarning.classList.add('hidden');
        
            // 处理每个选中的文件
            Array.from(files).forEach(file => {
                // 检查文件大小
                if (file.size > maxFileSize) {
                    fileSizeWarning.classList.remove('hidden');
                    return;
                }
        
                // 添加到选中文件列表
                selectedFiles.push(file);
                
                // 创建预览元素
                const filePreview = createFilePreview(file);
                filePreviewContainer.appendChild(filePreview);
            });
        
            // 清空input值，允许重复选择同一文件
            fileUpload.value = '';
        }
        
        // 创建文件预览
        function createFilePreview(file) {
            const preview = document.createElement('div');
            preview.className = 'flex items-center bg-neutral-100 rounded-md px-2 py-1 text-sm';
            preview.dataset.fileId = Date.now().toString(); // 用于标识文件
        
            let fileIcon = 'fa-file-o';
            if (file.type.startsWith('image/')) {
                fileIcon = 'fa-file-image-o';
            } else if (file.type.includes('pdf')) {
                fileIcon = 'fa-file-pdf-o';
            } else if (file.type.includes('word')) {
                fileIcon = 'fa-file-word-o';
            } else if (file.type.includes('excel')) {
                fileIcon = 'fa-file-excel-o';
            } else if (file.type.includes('powerpoint')) {
                fileIcon = 'fa-file-powerpoint-o';
            } else if (file.type.includes('zip') || file.type.includes('rar')) {
                fileIcon = 'fa-file-archive-o';
            } else if (file.type.includes('text')) {
                fileIcon = 'fa-file-text-o';
            }
        
            // 格式化文件名（过长时截断）
            const fileName = file.name.length > 20
                ? file.name.substring(0, 15) + '...' + file.name.split('.').pop()
                : file.name;
        
            // 格式化文件大小
            const fileSize = formatFileSize(file.size);
        
            preview.innerHTML = `
                <i class="fa ${fileIcon} text-neutral-500 mr-2"></i>
                <span class="truncate max-w-[150px]">${fileName}</span>
                <span class="text-neutral-400 text-xs ml-1">${fileSize}</span>
                <button type="button" class="remove-file ml-2 text-neutral-400 hover:text-red-500">
                    <i class="fa fa-times"></i>
                </button>
            `;
        
            // 添加删除文件事件
            preview.querySelector('.remove-file').addEventListener('click', () => {
                // 从选中文件列表中移除
                selectedFiles = selectedFiles.filter(f => f.name !== file.name || f.size !== file.size);
                preview.remove();
            });
        
            return preview;
        }
        
        // 格式化文件大小
        function formatFileSize(bytes) {
            if (bytes < 1024) return bytes + ' B';
            if (bytes < 1024 * 1024) return (bytes / 1024).toFixed(1) + ' KB';
            return (bytes / (1024 * 1024)).toFixed(1) + ' MB';
        }
        
        // 发送消息
        async function sendMessage() {
            const message = userInput.value.trim();
            
            // 如果没有消息也没有文件，则不发送
            if (!message && selectedFiles.length === 0) return;
            
            // 添加用户消息（支持Markdown）
            let userContent = message;
            if (selectedFiles.length > 0) {
                // 添加文件列表到消息内容
                const fileNames = selectedFiles.map(f => `📎 ${f.name}`).join('\n');
                userContent = message ? `${message}\n\n${fileNames}` : fileNames;
            }
            addMessage('user', userContent, false, true);
            
            // 清空输入框和文件选择
            userInput.value = '';
            userInput.style.height = 'auto';
            filePreviewContainer.innerHTML = '';
            
            // 添加AI正在输入的状态
            const loadingIndicator = addMessage('ai', '<div class="typing-animation text-neutral-700"></div>', true);
            
            try {
                // 显示连接状态
                updateStatus('connecting');
                
                // 创建FormData对象
                const formData = new FormData();
                formData.append('sessionId', sessionId);
                formData.append('clientName', clientName);
                formData.append('ucid', ucid);
                formData.append('message', message);
                
                // 添加文件
                selectedFiles.forEach((file, index) => {
                    formData.append(`files[${index}]`, file);
                });
                
                // 发送请求到远程服务
                const response = await fetch(API_URL, {
                    method: 'POST',
                    // 不需要设置Content-Type，浏览器会自动处理
                    body: formData
                });
                
                // 清空选中的文件
                selectedFiles = [];
                
                if (!response.ok) {
                    throw new Error(`HTTP error! status: ${response.status}`);
                }
                
                // 直接获取HTML响应
                const htmlResponse = await response.text();
                
                // 移除加载状态
                chatContainer.removeChild(loadingIndicator);
                
                // 添加AI回复（使用HTML）
                addMessage('ai', htmlResponse, false, true);
                
                // 显示成功状态
                updateStatus('success');
            } catch (error) {
                console.error('Error fetching AI response:', error);
                
                // 移除加载状态
                chatContainer.removeChild(loadingIndicator);
                
                // 添加错误提示
                addMessage('system', '抱歉，连接远程服务时发生错误。请稍后再试。');
                
                // 显示错误状态
                updateStatus('error');
            }
        }
        
        // 添加消息到聊天容器
        function addMessage(sender, content, isLoading = false, isMarkdown = false) {
            const messageDiv = document.createElement('div');
            messageDiv.className = `flex items-start ${sender === 'user' ? 'justify-end' : ''} mb-4 animate-[message-enter_0.3s_ease-out]`;
            
            // 为用户消息添加特殊类
            if (sender === 'user') {
                messageDiv.classList.add('user-message');
            }
            
            let avatarHtml, messageContentHtml, avatarClass, bgClass, textClass;
            
            if (sender === 'user') {
                avatarClass = 'bg-neutral-300 text-neutral-600';
                bgClass = 'bg-primary';
                textClass = 'text-white';
                icon = 'fa-user';
            } else if (sender === 'ai') {
                avatarClass = 'bg-primary text-white';
                bgClass = 'bg-neutral-100';
                textClass = 'text-neutral-700';
                icon = 'fa-robot';
            } else { // system
                avatarClass = 'bg-yellow-100 text-yellow-800';
                bgClass = 'bg-yellow-50';
                textClass = 'text-yellow-700';
                icon = 'fa-exclamation-triangle';
            }
            
            avatarHtml = `
                <div class="flex-shrink-0 ${sender === 'user' ? 'ml-3' : 'mr-3'}">
                    <div class="w-8 h-8 rounded-full ${avatarClass} flex items-center justify-center">
                        <i class="fa ${icon}"></i>
                    </div>
                </div>
            `;
            
            if (isLoading) {
                // 加载状态
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <p class="${textClass}">${content}</p>
                    </div>
                `;
            } else if (isMarkdown) {
                // 处理Markdown内容
                const markdownHtml = marked.parse(content);
                const cleanHtml = DOMPurify.sanitize(markdownHtml);
                
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <div class="markdown-content">${cleanHtml}</div>
                    </div>
                `;
            } else {
                // 普通文本内容
                messageContentHtml = `
                    <div class="${bgClass} rounded-lg p-3 max-w-[85%]">
                        <p class="${textClass}">${formatMessage(content)}</p>
                    </div>
                `;
            }
            
            messageDiv.innerHTML = sender === 'user' ? messageContentHtml + avatarHtml : avatarHtml + messageContentHtml;
            
            if (isLoading) {
                return chatContainer.appendChild(messageDiv);
            } else {
                chatContainer.appendChild(messageDiv);
                // 滚动到底部
                chatContainer.scrollTop = chatContainer.scrollHeight;
            }
        }
        
        // 更新连接状态
        function updateStatus(status) {
            const statusText = statusIndicator.querySelector('span:last-child');
            const statusDot = statusIndicator.querySelector('span:first-child');
            
            if (status === 'connecting') {
                statusText.textContent = '连接中...';
                statusDot.className = 'w-2 h-2 rounded-full bg-yellow-500 mr-2';
            } else if (status === 'success') {
                statusText.textContent = '已连接';
                statusDot.className = 'w-2 h-2 rounded-full bg-green-500 mr-2';
            } else if (status === 'error') {
                statusText.textContent = '连接错误';
                statusDot.className = 'w-2 h-2 rounded-full bg-red-500 mr-2';
            }
        }
        
        // 格式化消息内容（简单处理换行）
        function formatMessage(content) {
            return content.replace(/\n/g, '<br>');
        }
        
        // 绑定事件
        sendButton.addEventListener('click', sendMessage);
        
		// 在现有代码中添加输入法状态跟踪变量
		let isComposing = false;
		
		// 监听输入法组合事件
		userInput.addEventListener('compositionstart', () => {
		  isComposing = true;
		});
		
		userInput.addEventListener('compositionend', () => {
		  isComposing = false;
		});
		
		// 修改回车事件处理逻辑
		userInput.addEventListener('keydown', (e) => {
		  // 只有当不处于输入法组合状态且按下的是Enter键且未按Shift键时才提交
		  if (e.key === 'Enter' && !e.shiftKey && !isComposing) {
		    e.preventDefault();
		    sendMessage();
		  }
		});
        
        // 初始化焦点
        userInput.focus();
        
        // 测试连接状态
        function testConnection() {
            updateStatus('connecting');
            
            fetch(API_URL, { method: 'HEAD' })
                .then(response => {
                    if (response.ok) {
                        updateStatus('success');
                    } else {
                        updateStatus('error');
                    }
                })
                .catch(error => {
                    console.error('Connection test failed:', error);
                    updateStatus('error');
                });
        }
        
        // 页面加载时初始化会话ID显示并测试连接
        document.addEventListener('DOMContentLoaded', () => {
            initSessionIdDisplay();
            testConnection();
        });
    </script>
</body>
</html>
    